<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/" xmlns:eın="http://schemas.datacontract.org/2004/07/EInvoice.Service.Model">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:SendInvoiceXmlWithoutInvoiceNumber>
         <!--Optional:-->
         <tem:request>
            <!--Optional:-->
            <eın:CompanyVendorNumber></eın:CompanyVendorNumber>
            <!--Optional:-->
            <eın:Invoices>
               <!--Zero or more repetitions:-->
               <eın:InvoiceXml>
                  <!--Optional:-->
                  <eın:InvoiceContent>{{XmlB64}}</eın:InvoiceContent>
                  <!--Optional:-->
                  <eın:ReceiverTag>{{ReceiverTag}}</eın:ReceiverTag>
               </eın:InvoiceXml>
            </eın:Invoices>
         </tem:request>
      </tem:SendInvoiceXmlWithoutInvoiceNumber>
   </soapenv:Body>
</soapenv:Envelope>