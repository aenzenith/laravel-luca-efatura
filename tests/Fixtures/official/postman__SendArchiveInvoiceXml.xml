<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/" xmlns:eın="http://schemas.datacontract.org/2004/07/EInvoice.Service.Model">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:SendArchiveInvoiceXml>
         <!--Optional:-->
         <tem:request>
            <!--Optional:-->
            <eın:ArchiveInvoices>
               <!--Zero or more repetitions:-->
               <eın:ArchiveInvoiceXml>
                  <!--Optional:-->
                  <eın:ArchiveInvoiceContent>{{XmlB64}}</eın:ArchiveInvoiceContent>
                  <!--Optional:-->
                  <eın:SendMailAutomatically>true</eın:SendMailAutomatically>
               </eın:ArchiveInvoiceXml>
            </eın:ArchiveInvoices>
            <!--Optional:-->
            <eın:CompanyVendorNumber></eın:CompanyVendorNumber>
         </tem:request>
      </tem:SendArchiveInvoiceXml>
   </soapenv:Body>
</soapenv:Envelope>